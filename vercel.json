{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://eventmaster-backend-q77l.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": "vite"
} 